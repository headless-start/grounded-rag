# --- LLM backend (provider-agnostic, OpenAI-compatible) ---
# For a cloud key, set OPENAI_API_KEY and leave OPENAI_BASE_URL unset.
# For Project 2's local server, set OPENAI_BASE_URL to its address; key can be a dummy.
GR_OPENAI_API_KEY=sk-replace-me
# GR_OPENAI_BASE_URL=http://localhost:8001/v1
GR_LLM_MODEL=gpt-4o-mini

# --- embeddings / rerank (local) ---
GR_EMBED_MODEL=BAAI/bge-small-en-v1.5
GR_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- retrieval knobs ---
GR_TOP_K=20
GR_TOP_N=5
GR_REFUSAL_MIN_CONTEXTS=1

# --- storage ---
GR_CHROMA_DIR=.chroma
GR_COLLECTION=grounded_rag
GR_DATA_DIR=data
